/// Five-fold cross-validation results for cp values 0.001 through 0.020.
table 'CP Tuning'

	column 'Complexity Parameter'
		dataType: decimal
		formatString: 0.000
		summarizeBy: none
		sourceColumn: cp

	column ROC
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: ROC

	column Sensitivity
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Sens

	column Specificity
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Spec

	column 'ROC Standard Deviation'
		dataType: decimal
		formatString: 0.000
		summarizeBy: none
		sourceColumn: ROCSD

	column 'Sensitivity Standard Deviation'
		dataType: decimal
		formatString: 0.000
		summarizeBy: none
		sourceColumn: SensSD

	column 'Specificity Standard Deviation'
		dataType: decimal
		formatString: 0.000
		summarizeBy: none
		sourceColumn: SpecSD

