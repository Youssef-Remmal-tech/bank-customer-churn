/// Reference scenarios covering Female, Male, all geographies, and both active-member states.
table 'Prediction Validation Cases'

	column Case
		dataType: string
		summarizeBy: none
		sourceColumn: Case

	column 'Credit Score'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CreditScore

	column Geography
		dataType: string
		summarizeBy: none
		sourceColumn: Geography

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: Gender

	column Age
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Age

	column Tenure
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Tenure

	column Balance
		dataType: decimal
		formatString: £#,##0
		summarizeBy: none
		sourceColumn: Balance

	column 'Number of Products'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: NumOfProducts

	column 'Has Credit Card'
		dataType: string
		summarizeBy: none
		sourceColumn: HasCrCard

	column 'Is Active Member'
		dataType: string
		summarizeBy: none
		sourceColumn: IsActiveMember

	column 'Estimated Salary'
		dataType: decimal
		formatString: £#,##0
		summarizeBy: none
		sourceColumn: EstimatedSalary

	column 'Task 1 Class'
		dataType: string
		summarizeBy: none
		sourceColumn: Task1Class

	column 'Task 1 Exit Probability'
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Task1ExitProbability

	column 'Task 2 Class'
		dataType: string
		summarizeBy: none
		sourceColumn: Task2Class

	column 'Task 2 Exit Probability'
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Task2ExitProbability

