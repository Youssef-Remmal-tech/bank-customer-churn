/// One row per BangorBank customer; 10,000 rows from the supplied source CSV.
table Customers

	/// Number of customer records in the current filter context.
	measure 'Customer Count' = COUNTROWS(Customers)
		formatString: #,##0

	/// Customers whose observed outcome is Exited = 1.
	measure 'Exit Count' = SUM(Customers[Exited])
		formatString: #,##0

	/// Observed exited customers divided by customers in the current filter context.
	measure 'Exit Rate' = DIVIDE([Exit Count], [Customer Count])
		formatString: 0.0%

	/// Mean customer age in years.
	measure 'Average Age' = AVERAGE(Customers[Age])
		formatString: 0.0

	/// Mean recorded account balance.
	measure 'Average Balance' = AVERAGE(Customers[Balance])
		formatString: £#,##0

	/// Mean credit score.
	measure 'Average Credit Score' = AVERAGE(Customers[Credit Score])
		formatString: 0

	column 'Credit Score'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CreditScore

	column Geography
		dataType: string
		summarizeBy: none
		sourceColumn: Geography

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: Gender

	column Age
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Age

	column Tenure
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Tenure

	column Balance
		dataType: decimal
		formatString: £#,##0.00
		summarizeBy: none
		sourceColumn: Balance

	column 'Number of Products'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: NumOfProducts

	column 'Has Credit Card'
		dataType: string
		summarizeBy: none
		sourceColumn: HasCrCard

	column 'Is Active Member'
		dataType: string
		summarizeBy: none
		sourceColumn: IsActiveMember

	column 'Estimated Salary'
		dataType: decimal
		formatString: £#,##0.00
		summarizeBy: none
		sourceColumn: EstimatedSalary

	column Exited
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Exited

	column 'Age Band'
		dataType: string
		summarizeBy: none
		sourceColumn: AgeBand

	column 'Exited Label'
		dataType: string
		summarizeBy: none
		sourceColumn: ExitedLabel

	column 'Active Member Label'
		dataType: string
		summarizeBy: none
		sourceColumn: ActiveMemberLabel

